{
  "name": "islandora/islandora-starter-site",
  "description": "Project template for Islandora sites.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.islandora.ca",
  "support": {
    "docs": "https://islandora.github.io/documentation/",
    "chat": "https://www.islandora.ca/community#channels-of-communication"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    {
      "type": "package",
      "package": {
        "name": "library/pdf.js",
        "version": "2.16.105",
        "type": "drupal-library",
        "dist": {
          "url": "https://github.com/mozilla/pdf.js/releases/download/v2.16.105/pdfjs-2.16.105-dist.zip",
          "type": "zip"
        }
      }
    }
  ],
  "require": {
    "php": "^7.4 || ^8",
    "composer/installers": "^1.9",
    "cweagans/composer-patches": "^1.7",
    "drupal/address": "^2.0",
    "drupal/admin_toolbar": "^3.1",
    "drupal/auto_entitylabel": "^3.3",
    "drupal/bartik": "^1.0",
    "drupal/base_field_override_ui": "^1.2",
    "drupal/better_exposed_filters": "^6.0",
    "drupal/bibcite": "^3.0@beta",
    "drupal/block_class": "^3.0",
    "drupal/block_exclude_pages": "^2.1",
    "drupal/chosen": "^4.0",
    "drupal/citation_select": "^2.0@beta",
    "drupal/ckeditor5_font": "^1.1@beta",
    "drupal/coi": "^4.0",
    "drupal/config_update": "^2.0@alpha",
    "drupal/context": "^5@RC",
    "drupal/controlled_access_terms": "^2",
    "drupal/core-composer-scaffold": "^10.1",
    "drupal/core-recommended": "^10.1",
    "drupal/cshs": "^4.0",
    "drupal/custom_field": "^3.0@RC",
    "drupal/datafield": "^2.0",
    "drupal/entity_browser": "^2.12",
    "drupal/entity_comparison": "^4.0",
    "drupal/entity_diff_ui": "^2.0@alpha",
    "drupal/entity_reference_unpublished": "^2.0",
    "drupal/epp": "^1.7",
    "drupal/facets": "^3",
    "drupal/field_group": "^3",
    "drupal/field_permissions": "^1",
    "drupal/field_report": "^2.1",
    "drupal/field_token_value": "^3.0",
    "drupal/file_download_link": "^2.0",
    "drupal/floating_block": "^2.0",
    "drupal/flood_control": "^3.0",
    "drupal/flysystem": "^2.0@alpha",
    "drupal/fpa": "^4.0",
    "drupal/geocoder": "^4.25",
    "drupal/geofield": "^1.59",
    "drupal/geofield_map": "^11.0",
    "drupal/group": "^3.2",
    "drupal/group_action": "^1.1",
    "drupal/group_relationship_tokens": "^1.0",
    "drupal/groupmedia": "^4.0",
    "drupal/hal": "^1.0||^2.0",
    "drupal/imagemagick": "^4",
    "drupal/imce": "^3.1",
    "drupal/inline_entity_form": "^3.0@RC",
    "drupal/islandora": "^2.13",
    "drupal/islandora_mirador": "^2.3",
    "drupal/leaflet": "^10.2",
    "drupal/matomo": "^1.19",
    "drupal/metatag": "^2.0",
    "drupal/migrate_conditions": "^2.1",
    "drupal/migrate_tools": "^6.0",
    "drupal/multi_domain_login": "^1.0",
    "drupal/name": "^1.0@RC",
    "drupal/openseadragon": "^2",
    "drupal/pdf": "^1.1",
    "drupal/persistent_identifiers-persistent_identifiers": "^1.0",
    "drupal/photoswipe": "^5.0",
    "drupal/pluginformalter": "^1.7",
    "drupal/range": "^1.5",
    "drupal/redirect_after_login": "^3.0",
    "drupal/rest_oai_pmh": "^2.0@beta",
    "drupal/rest_views": "^3.1",
    "drupal/save_edit": "^1.8",
    "drupal/search_api_autocomplete": "^1.9",
    "drupal/search_api_fast": "^2.3",
    "drupal/search_api_location": "^1.0@alpha",
    "drupal/search_api_solr": "^4.2",
    "drupal/search_api_sorts": "^1.2",
    "drupal/security_review": "^3.1",
    "drupal/shs": "^2.0@RC",
    "drupal/simple_block": "^1.7",
    "drupal/simplelogin": "^7.1",
    "drupal/superfish": "^1.8",
    "drupal/taxonomy_manager": "^2.0",
    "drupal/term_merge": "^2.0@beta",
    "drupal/threejs": "^1.0",
    "drupal/twig_tweak": "^3.2",
    "drupal/user_redirect": "^2.0",
    "drupal/view_unpublished": "^1.3",
    "drupal/viewfield": "^3.0@beta",
    "drupal/views_aggregator": "^2.1",
    "drupal/views_argument_token": "^2.0",
    "drupal/views_bulk_edit": "^3",
    "drupal/views_bulk_operations": "^4.2",
    "drupal/views_data_export": "^1.2",
    "drupal/views_field_view": "^1.0@beta",
    "drupal/views_fieldsets": "^4.0",
    "drupal/views_infinite_scroll": "^2.0",
    "drupal/views_term_hierarchy_weight_field": "^1.4",
    "drush/drush": "^12",
    "geocoder-php/geo-plugin-provider": "^4.3",
    "geocoder-php/google-maps-provider": "^4.7",
    "geocoder-php/nominatim-provider": "^5.7",
    "islandora-rdm/islandora_fits": "dev-8.x-1.x as 1.x-dev",
    "islandora/views_nested_details": "^1.0",
    "library/pdf.js": "^2.4",
    "mjordan/islandora_workbench_integration": "dev-main"
  },
  "conflict": {
    "drupal/drupal": "*",
    "drupal/core": "<=8",
    "drupal/matomo": "<1.24.0",
    "drupal/flysystem": "<2.2",
    "twig/twig": "<3.19.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "discard-changes": "stash",
    "allow-plugins": {
      "composer/installers": true,
      "cweagans/composer-patches": true,
      "drupal/core-composer-scaffold": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true
    },
    "sort-packages": true
  },
  "extra": {
    "drupal-scaffold": {
      "locations": {
        "web-root": "web/"
      },
      "file-mapping": {
        "[web-root]/robots.txt": {
          "append": "assets/robots-additions.txt"
        }
      }
    },
    "installer-paths": {
      "web/core": [
        "type:drupal-core"
      ],
      "web/libraries/{$name}": [
        "type:drupal-library"
      ],
      "web/modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "web/profiles/contrib/{$name}": [
        "type:drupal-profile"
      ],
      "web/themes/contrib/{$name}": [
        "type:drupal-theme"
      ],
      "drush/Commands/contrib/{$name}": [
        "type:drupal-drush"
      ],
      "web/modules/custom/{$name}": [
        "type:drupal-custom-module"
      ],
      "web/profiles/custom/{$name}": [
        "type:drupal-custom-profile"
      ],
      "web/themes/custom/{$name}": [
        "type:drupal-custom-theme"
      ]
    },
    "patches": {
      "drupal/core": {
        "ImageStyle": "./patches/ImageStyle.patch",
        "Datafield error fix: display references in select list": "./patches/form.inc.patch",
        "Datafield error fix: save references in select list": "./patches/SqlContent.patch",
        "Claro: hide silly 'Add' button": "./patches/claro.node.patch"
      },
      "drupal/persistent_identifiers-persistent_identifiers": {
        "Create handle automatically on node save/creation": "./patches/persistent_identifiers.patch",
        "Reenable qualifier field in configuration": "./patches/hdl.module.patch",
        "Change handle format": "./patches/Hdl.patch",
        "Fix datafield behaviour": "./patches/Generic.patch"
      },
      "drupal/facets": {
        "DefaultFacetsSummaryManager": "./patches/DefaultFacetsSummaryManager.patch",
        "Add processor HideWhenNoFilters to hide empty facet summary": "./patches/HideWhenNoFilters.patch",
        "Show empty facets": "./patches/FacetsFilter.patch"
      },
      "drupal/islandora": {
        "Add Media Wizard": "./patches/IslandoraMediaWizard.patch",
        "Change view mode on any page": "./patches/islandora.module-2.14.3.patch"
      },
      "drupal/metatag": {
        "Make all field multiple": "./patches/MetaNameBase.patch"
      },
      "drupal/group": {
        "Allow adding entities to group from non-default views": "./patches/gnode.links.action.patch"
      },
      "drupal/entity_comparison": {
        "Add Group Code": "./patches/EntityComparisonAddGroupCode.patch"
      },
      "drupal/taxonomy_manager": {
        "Add permission for config": "./patches/taxonomy_manager.routing.patch"
      }
    }
  },
  "scripts": {
    "post-root-package-install": [
      "Islandora\\StarterSite::rootPackageInstall"
    ]
  },
  "require-dev": {
    "drupal/config_inspector": "^2.1",
    "drupal/devel": "^5.0",
    "drupal/restui": "^1.21"
  },
  "autoload": {
    "classmap": [
      "assets/IslandoraStarterSite.php"
    ]
  }
}
